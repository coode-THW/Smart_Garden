# ============================================================
# SmartGarden 环境变量配置模板
# ============================================================

# 复制此文件为 .env 并填写实际值

# ━━━ LLM API 密钥 ━━━

# 主模型 API Key（GPT-4o-mini）
LLM_API_KEY=your-openai-api-key-here

# 备用模型 API Key（Moonshot）
MOONSHOT_API_KEY=your-moonshot-api-key-here

# ━━━ LLM 配置（可选，默认已在代码中配置）━━━

# 主模型 URL
# LLM_PRIMARY_URL=https://api.openai.com/v1/chat/completions

# 备用模型 URL
# LLM_SECONDARY_URL=https://api.moonshot.cn/v1/chat/completions

# 主模型名称
# LLM_MODEL_NAME=gpt-4o-mini

# 备用模型名称
# LLM_SECONDARY_MODEL=moonshot-v1-8k