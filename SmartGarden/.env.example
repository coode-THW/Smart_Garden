# ============================================================
# SmartGarden 环境变量配置模板
# ============================================================

# 复制此文件为 .env 并填写实际值

# ━━━ LLM API 密钥 ━━━

# 主模型 API Key（阿里云通义千问）
QWEN_API_KEY=your-aliyun-dashscope-api-key

# 备用模型 API Key（DeepSeek）
DEEPSEEK_API_KEY=your-deepseek-api-key

# ━━━ LLM 配置（可选，默认已在代码中配置）━━━

# 主模型 URL（阿里云通义千问兼容模式）
# LLM_PRIMARY_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 备用模型 URL（DeepSeek）
# LLM_SECONDARY_URL=https://api.deepseek.com/v1/chat/completions

# 主模型名称（千问视觉模型）
# LLM_MODEL_NAME=qwen-vl-plus

# 备用模型名称（DeepSeek）
# LLM_SECONDARY_MODEL=deepseek-chat