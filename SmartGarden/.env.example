# ============================================================
# SmartGarden 环境变量配置模板
# ============================================================

# 复制此文件为 .env 并填写实际值

# ━━━ LLM API 密钥 ━━━

# 主模型 API Key（阿里云通义千问）
QWEN_API_KEY=your_qwen_api_key_here

# 备用模型 API Key（豆包 Doubao）
# ⚠️ 变量名必须是 DOUBAO_API_KEY —— src/setupEnv.ts 与 LlmService.ts 读的就是它。
#    此前这里写的是 DEEPSEEK_API_KEY，照抄模板会导致备用模型 key 静默为空。
DOUBAO_API_KEY=your_doubao_api_key_here


# ━━━ LLM 配置（可选，默认已在代码中配置）━━━

# 主模型 URL（阿里云通义千问兼容模式）
# LLM_PRIMARY_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 备用模型 URL（DeepSeek）
# LLM_SECONDARY_URL=https://api.deepseek.com/v1/chat/completions

# 主模型名称（千问视觉模型）
# LLM_MODEL_NAME=qwen-vl-plus

# 备用模型名称（DeepSeek）
# LLM_SECONDARY_MODEL=deepseek-chat


# ━━━ 模型 / 知识库在线更新（可选）━━━
# 未配置时对应检查直接跳过，不影响 APP 启动与核心功能

# 模型 version.json 地址
# MODEL_VERSION_URL=https://your-host/flowers/model_version.json

# 知识库 version.json 地址（Day51-52 起使用）
# KNOWLEDGE_VERSION_URL=https://your-host/flowers/care/version.json